b.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"c5a952cbd1df731c136abf8c062bf847663104ad","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/c5a952cbd1df731c136abf8c062bf847663104ad","html_url":"https://github.com/RMYPG/edity-sandbox/commit/c5a952cbd1df731c136abf8c062bf847663104ad"},{"sha":"4175a57a9f46b283e979c5a6aec34d4ea35c987c","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/4175a57a9f46b283e979c5a6aec34d4ea35c987c","html_url":"https://github.com/RMYPG/edity-sandbox/commit/4175a57a9f46b283e979c5a6aec34d4ea35c987c"}]},{"sha":"b0441f3d32b2017cf19d240a546f37b07320f747","node_id":"C_kwDOVWyoCNoAKGIwNDQxZjNkMzJiMjAxN2NmMTlkMjQwYTU0NmYzN2IwNzMyMGY3NDc","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:50:08Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:50:08Z"},"message":"build: copy vendor/ into the image before installing\n\nThe image installs dependencies from the manifests alone, before copying\nthe rest, so pnpm couldn't find the vendored @edity/* tarballs.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"25eafc34888b258695963cbd2c81381c677e2c8d","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/25eafc34888b258695963cbd2c81381c677e2c8d"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/b0441f3d32b2017cf19d240a546f37b07320f747","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/b0441f3d32b2017cf19d240a546f37b07320f747","html_url":"https://github.com/RMYPG/edity-sandbox/commit/b0441f3d32b2017cf19d240a546f37b07320f747","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/b0441f3d32b2017cf19d240a546f37b07320f747/comments","author":null,"committer":null,"parents":[{"sha":"58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d","html_url":"https://github.com/RMYPG/edity-sandbox/commit/58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d"}]},{"sha":"58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d","node_id":"C_kwDOVWyoCNoAKDU4NTAxYTQwMmE1ZTQ5ZTM5YzA3MzljZTBmZTM5YTJlNWQ3ZjdlNmQ","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:47:17Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:47:17Z"},"message":"feat: mark the home page up for the Editor, with a dev-only login\n\nThe page goes through editable() and <Items>, so every Field carries\ndata-edity-field, every List data-edity-list with one <template>, and\n<body> the page marker (a new Layout prop). The built page is the one\nbefore but for those attributes, the templates and the 82-byte inline\ncheck (N2), and visitors load no Editor code.\n\nedity-dev-login.mjs answers /_edity/login and /_edity/api/session under\nastro dev only, so the Editor can be tried here until edity-server's\nlogin exists (edity ticket 25). Astro's dev toolbar is off, since it sat\nunder the Editor's bar. The README says how to try it.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"558f61d0f373c54f7e855b818a4145236ea08697","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/558f61d0f373c54f7e855b818a4145236ea08697"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d","html_url":"https://github.com/RMYPG/edity-sandbox/commit/58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/58501a402a5e49e39c0739ce0fe39a2e5d7f7e6d/comments","author":null,"committer":null,"parents":[{"sha":"c4530add042d6db0325685f4eb8906732bbddcf2","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/c4530add042d6db0325685f4eb8906732bbddcf2","html_url":"https://github.com/RMYPG/edity-sandbox/commit/c4530add042d6db0325685f4eb8906732bbddcf2"}]},{"sha":"c4530add042d6db0325685f4eb8906732bbddcf2","node_id":"C_kwDOVWyoCNoAKGM0NTMwYWRkMDQyZDZkYjAzMjU2ODVmNGViODkwNjczMmJiZGRjZjI","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:43:43Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:43:43Z"},"message":"feat: move the home page's content to JSON, validated by its Field definitions\n\nEdity ticket 05. The content of src/data/home.ts moves to src/content/home.json,\nloaded through @edity/astro's edityPage() loader with the page's Field\ndefinitions written in content.config.ts with @edity/core, and the\ngenerated JSON Schema committed as src/content/home.schema.json. The built\npage is byte-identical to the one before, and breaking a Limit in the\nJSON fails the build with the path and the Limit.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"e4812ccfafda2bf15bd751c4a2a1015f9aa01451","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/e4812ccfafda2bf15bd751c4a2a1015f9aa01451"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/c4530add042d6db0325685f4eb8906732bbddcf2","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/c4530add042d6db0325685f4eb8906732bbddcf2","html_url":"https://github.com/RMYPG/edity-sandbox/commit/c4530add042d6db0325685f4eb8906732bbddcf2","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/c4530add042d6db0325685f4eb8906732bbddcf2/comments","author":null,"committer":null,"parents":[{"sha":"b4a4a140e2f873e7904e50185e49d4781ef41efd","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/b4a4a140e2f873e7904e50185e49d4781ef41efd","html_url":"https://github.com/RMYPG/edity-sandbox/commit/b4a4a140e2f873e7904e50185e49d4781ef41efd"}]},{"sha":"b4a4a140e2f873e7904e50185e49d4781ef41efd","node_id":"C_kwDOVWyoCNoAKGI0YTRhMTQwZTJmODczZTc5MDRlNTAxODVlNDlkNDc4MWVmNDFlZmQ","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:43:43Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:43:43Z"},"message":"build: add @edity/core and @edity/astro 0.1.0 from vendored tarballs\n\n0.1.0 isn't on npm yet, so both packages are packed from RMYPG/edity at\nc69170b into vendor/, with an override so @edity/astro's own dependency on\n@edity/core resolves to the same tarball. vendor/README.md says how to\nrefresh them and how to switch to npm once 0.1.0 is published. zod comes\nalong as the peer dependency both packages share with Astro.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"44c37bf77dd274e1b67a43d33410619061e80fad","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/44c37bf77dd274e1b67a43d33410619061e80fad"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/b4a4a140e2f873e7904e50185e49d4781ef41efd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/b4a4a140e2f873e7904e50185e49d4781ef41efd","html_url":"https://github.com/RMYPG/edity-sandbox/commit/b4a4a140e2f873e7904e50185e49d4781ef41efd","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/b4a4a140e2f873e7904e50185e49d4781ef41efd/comments","author":null,"committer":null,"parents":[{"sha":"164c6be510beea790c04235dd4f91757fd9c94d5","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/164c6be510beea790c04235dd4f91757fd9c94d5","html_url":"https://github.com/RMYPG/edity-sandbox/commit/164c6be510beea790c04235dd4f91757fd9c94d5"}]},{"sha":"164c6be510beea790c04235dd4f91757fd9c94d5","node_id":"C_kwDOVWyoCNoAKDE2NGM2YmU1MTBiZWVhNzkwYzA0MjM1ZGQ0ZjkxNzU3ZmQ5Yzk0ZDU","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:40:27Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:40:27Z"},"message":"feat: a home page with every case the Editor handles\n\nEdity ticket 04. The page has a heading and a paragraph with line Limits in\nmind, whole and decimal numbers formatted for es-ES, a value shown twice\n(the brand, once inside a link), text inside a link and a button, a\nsimple bullet List and a List of cards that each hold a List. The content\nis Spanish, with accents and emoji, and lives in src/data/home.ts until\nits Migration to a content collection (ticket 05).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"486d692772f118790bb6adb5b5968cb57044b4fe","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/486d692772f118790bb6adb5b5968cb57044b4fe"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/164c6be510beea790c04235dd4f91757fd9c94d5","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/164c6be510beea790c04235dd4f91757fd9c94d5","html_url":"https://github.com/RMYPG/edity-sandbox/commit/164c6be510beea790c04235dd4f91757fd9c94d5","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/164c6be510beea790c04235dd4f91757fd9c94d5/comments","author":null,"committer":null,"parents":[{"sha":"a7c452a519c374389a1ce59e3c09e97f6f751063","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/a7c452a519c374389a1ce59e3c09e97f6f751063","html_url":"https://github.com/RMYPG/edity-sandbox/commit/a7c452a519c374389a1ce59e3c09e97f6f751063"}]},{"sha":"a7c452a519c374389a1ce59e3c09e97f6f751063","node_id":"C_kwDOVWyoCNoAKGE3YzQ1MmE1MTljMzc0Mzg5YTFjZTU5ZTNjMDllOTdmNmY3NTEwNjM","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:40:27Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-26T13:40:27Z"},"message":"test: let the browser tests run on another port\n\nOutside CI, Playwright reuses whatever listens on 4321, so with another\nSite's dev server there the tests checked that Site. PLAYWRIGHT_PORT moves\nthem, and preview runs with --ignore-lock so Astro keeps it in the\nforeground even when it takes the caller for an AI agent.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"bbdf1b46bf108ab6829a23647ab0960b37850d72","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/bbdf1b46bf108ab6829a23647ab0960b37850d72"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/a7c452a519c374389a1ce59e3c09e97f6f751063","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/a7c452a519c374389a1ce59e3c09e97f6f751063","html_url":"https://github.com/RMYPG/edity-sandbox/commit/a7c452a519c374389a1ce59e3c09e97f6f751063","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/a7c452a519c374389a1ce59e3c09e97f6f751063/comments","author":null,"committer":null,"parents":[{"sha":"c5a952cbd1df731c136abf8c062bf847663104ad","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/c5a952cbd1df731c136abf8c062bf847663104ad","html_url":"https://github.com/RMYPG/edity-sandbox/commit/c5a952cbd1df731c136abf8c062bf847663104ad"}]},{"sha":"4175a57a9f46b283e979c5a6aec34d4ea35c987c","node_id":"C_kwDOVWyoCNoAKDQxNzVhNTdhOWY0NmIyODNlOTc5YzVhNmFlYzM0ZDRlYTM1Yzk4N2M","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-25T15:31:53Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-25T15:32:01Z"},"message":"Release Edity Publish commits once CI passes\n\nAdd a Release on Publish workflow that calls release.yml for a commit on\nmain once CI succeeds on it, when the login that pushed it is listed in\nthe EDITY_PUBLISHER_LOGINS repository variable.\n\nrelease.yml takes the sha to release as a workflow_call input, because a\nworkflow_run's GITHUB_SHA is main's HEAD rather than the commit CI ran\non. A called run whose commit the latest release tag already contains,\nsuch as an older Publish whose CI finished last or a CI re-run, ends with\na notice instead of failing the version checks. The concurrency group\nmoves to the job so it also covers called runs. Manual dispatch is\nunchanged.\n\nEdity ticket 27, \"Release workflow for Publish commits\".\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"e6cfcca1556c1788e05a32d63efb5b25ec882200","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/e6cfcca1556c1788e05a32d63efb5b25ec882200"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/4175a57a9f46b283e979c5a6aec34d4ea35c987c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/4175a57a9f46b283e979c5a6aec34d4ea35c987c","html_url":"https://github.com/RMYPG/edity-sandbox/commit/4175a57a9f46b283e979c5a6aec34d4ea35c987c","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/4175a57a9f46b283e979c5a6aec34d4ea35c987c/comments","author":null,"committer":null,"parents":[{"sha":"1e74cd9a3ab41a006a58b236a2dcb3e29e136163","url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/1e74cd9a3ab41a006a58b236a2dcb3e29e136163","html_url":"https://github.com/RMYPG/edity-sandbox/commit/1e74cd9a3ab41a006a58b236a2dcb3e29e136163"}]},{"sha":"1e74cd9a3ab41a006a58b236a2dcb3e29e136163","node_id":"C_kwDOVWyoCNoAKDFlNzRjZDlhM2FiNDFhMDA2YTU4YjIzNmEyZGNiM2UyOWUxMzYxNjM","commit":{"author":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-25T15:31:53Z"},"committer":{"name":"Mario Rojas Padron","email":"mariorpadron01@gmail.com","date":"2026-10-25T15:32:01Z"},"message":"Lint workflows with actionlint and ShellCheck\n\nPin both in mise.toml, and declare the Blacksmith runner label in\n.github/actionlint.yaml so the existing workflows pass.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"38af64c747ec5b44f1eba6d92f992a86f6773412","url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/trees/38af64c747ec5b44f1eba6d92f992a86f6773412"},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/git/commits/1e74cd9a3ab41a006a58b236a2dcb3e29e136163","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/1e74cd9a3ab41a006a58b236a2dcb3e29e136163","html_url":"https://github.com/RMYPG/edity-sandbox/commit/1e74cd9a3ab41a006a58b236a2dcb3e29e136163","comments_url":"https://api.github.com/repos/RMYPG/edity-sandbox/commits/1e74