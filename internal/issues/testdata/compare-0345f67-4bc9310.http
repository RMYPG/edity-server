b.com/repos/RMYPG/edity-sandbox/commits/31077c358f1b793aefc1c495c938055d99d3c227","html_url":"https://github.com/RMYPG/edity-sandbox/commit/31077c358f1b793aefc1c495c938055d99d3c227"}]}],"files":[{"sha":"95077902af2072fef6539436b8a0dd4be18b70de","filename":"Dockerfile","status":"modified","additions":0,"deletions":2,"changes":2,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/4bc931076ac8583bd8905a4c508c987877afc09d/Dockerfile","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/4bc931076ac8583bd8905a4c508c987877afc09d/Dockerfile","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/Dockerfile?ref=4bc931076ac8583bd8905a4c508c987877afc09d","patch":"@@ -3,8 +3,6 @@ WORKDIR /app\n \n RUN corepack enable\n COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./\n-# The @edity/* tarballs package.json depends on, until they are on npm.\n-COPY vendor ./vendor\n RUN pnpm install --frozen-lockfile\n \n COPY . ."},{"sha":"e720f1ccdf28284ccf09fcd96b703c163902110a","filename":"README.md","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/4bc931076ac8583bd8905a4c508c987877afc09d/README.md","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/4bc931076ac8583bd8905a4c508c987877afc09d/README.md","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/README.md?ref=4bc931076ac8583bd8905a4c508c987877afc09d","patch":"@@ -33,7 +33,7 @@ This Site is Edity's sandbox: development Publishes go here, never to a Client's\n \n - Changing a Limit: `node --run dev` rewrites `home.schema.json`; commit it. `node --run build` fails while it is stale, and when the JSON breaks a Limit.\n - Trying the Editor: run `node --run dev` and open `http://localhost:4321/_edity/login` to sign in as Ana, in Spanish, or `/_edity/login?name=Sam&locale=en` for English. `edity-dev-login.mjs` stands in for `edity-server`'s login until it exists, and only under `astro dev`. Publish does nothing yet.\n-- `@edity/core` and `@edity/astro` come from `vendor/` until 0.1.0 is on npm (see `vendor/README.md`).\n+- `@edity/core` and `@edity/astro` come from npm. `pnpm-workspace.yaml` exempts `@edity/*` from the three-day `minimumReleaseAge`, so a new Edity release can be tried here the day it is out.\n \n ## Container\n "},{"sha":"1334aae914fc33ec758c4cf8e268ed25e3eebf2a","filename":"package.json","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/4bc931076ac8583bd8905a4c508c987877afc09d/package.json","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/4bc931076ac8583bd8905a4c508c987877afc09d/package.json","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/package.json?ref=4bc931076ac8583bd8905a4c508c987877afc09d","patch":"@@ -2,7 +2,7 @@\n   \"name\": \"static-astro-site-template\",\n   \"private\": true,\n   \"type\": \"module\",\n-  \"version\": \"1.0.0\",\n+  \"version\": \"1.0.1\",\n   \"engines\": {\n     \"node\": \"24.x\"\n   },\n@@ -21,8 +21,8 @@\n   },\n   \"dependencies\": {\n     \"@astrojs/check\": \"^0.9.11\",\n-    \"@edity/astro\": \"file:vendor/edity-astro-0.1.0.tgz\",\n-    \"@edity/core\": \"file:vendor/edity-core-0.1.0.tgz\",\n+    \"@edity/astro\": \"^0.1.0\",\n+    \"@edity/core\": \"^0.1.0\",\n     \"astro\": \"^7.4.1\",\n     \"sharp\": \"^0.35.5\",\n     \"typescript\": \"^6.0.3\","},{"sha":"5afffd213131b819d33221f45ed3a6ef57f565ef","filename":"pnpm-lock.yaml","status":"modified","additions":11,"deletions":16,"changes":27,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/4bc931076ac8583bd8905a4c508c987877afc09d/pnpm-lock.yaml","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/4bc931076ac8583bd8905a4c508c987877afc09d/pnpm-lock.yaml","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/pnpm-lock.yaml?ref=4bc931076ac8583bd8905a4c508c987877afc09d","patch":"@@ -162,9 +162,6 @@ settings:\n   autoInstallPeers: true\n   excludeLinksFromLockfile: false\n \n-overrides:\n-  '@edity/core': file:vendor/edity-core-0.1.0.tgz\n-\n importers:\n \n   .:\n@@ -173,11 +170,11 @@ importers:\n         specifier: ^0.9.11\n         version: 0.9.12(@emnapi/runtime@1.11.3)(prettier-plugin-astro@1.1.1(@emnapi/core@1.11.3)(@emnapi/runtime@1.11.3)(prettier@3.9.10))(prettier@3.9.10)(typescript@6.0.3)\n       '@edity/astro':\n-        specifier: file:vendor/edity-astro-0.1.0.tgz\n-        version: file:vendor/edity-astro-0.1.0.tgz(astro@7.4.2(@types/node@24.19.2)(yaml@2.9.1))(zod@4.6.7)\n+        specifier: ^0.1.0\n+        version: 0.1.0(astro@7.4.2(@types/node@24.19.2)(yaml@2.9.1))(zod@4.6.7)\n       '@edity/core':\n-        specifier: file:vendor/edity-core-0.1.0.tgz\n-        version: file:vendor/edity-core-0.1.0.tgz(zod@4.6.7)\n+        specifier: ^0.1.0\n+        version: 0.1.0(zod@4.6.7)\n       astro:\n         specifier: ^7.4.1\n         version: 7.4.2(@types/node@24.19.2)(yaml@2.9.1)\n@@ -495,16 +492,14 @@ packages:\n     resolution: {integrity: sha512-dlT1m5e/0yUL0kRNcQn7yGLVThkgbB0Ga/1AmfDDC/8ik6AIiSf2QLQO2zPYvefsHP0aFgxO93cVLCCfDp7kzQ==}\n     engines: {node: '>= 20.12.0'}\n \n-  '@edity/astro@file:vendor/edity-astro-0.1.0.tgz':\n-    resolution: {integrity: sha512-eRW7wcYFfP5JzKr85gmIeh+RHzVVjajS9eSyyKWkk6bE7kjlJRAotPHP897B6W5oyP2Bxr1rWvw1pptB5rE53w==, tarball: file:vendor/edity-astro-0.1.0.tgz}\n-    version: 0.1.0\n+  '@edity/astro@0.1.0':\n+    resolution: {integrity: sha512-8UNHK6nIPpi8t/dfakNP/8LPzGpKvlvDzf+neu3I1JVguofexOtMbRY8VirNy5fc1+d7drypWExZZF03MJ0kqw==}\n     peerDependencies:\n       astro: ^7.4.0\n       zod: ^4.6.0\n \n-  '@edity/core@file:vendor/edity-core-0.1.0.tgz':\n-    resolution: {integrity: sha512-JcZRf3qw4eb4zwJxWSQ74fYa48HiFQhaW/UZwbCiAQcJHwkB8DOzbyu90k1gHIhERH00c4RfM8fbVGHWHDpIWg==, tarball: file:vendor/edity-core-0.1.0.tgz}\n-    version: 0.1.0\n+  '@edity/core@0.1.0':\n+    resolution: {integrity: sha512-Dyw+K+nYMuOlaEXYIPRXThGvtONIcZVAe+15DIiifqhoOxjz6oQG/g0gKaRBa0nEZsBLl8S+LO+7KihreqS4JA==}\n     peerDependencies:\n       zod: ^4.6.0\n \n@@ -2616,13 +2611,13 @@ snapshots:\n       fast-wrap-ansi: 0.2.2\n       sisteransi: 1.0.5\n \n-  '@edity/astro@file:vendor/edity-astro-0.1.0.tgz(astro@7.4.2(@types/node@24.19.2)(yaml@2.9.1))(zod@4.6.7)':\n+  '@edity/astro@0.1.0(astro@7.4.2(@types/node@24.19.2)(yaml@2.9.1))(zod@4.6.7)':\n     dependencies:\n-      '@edity/core': file:vendor/edity-core-0.1.0.tgz(zod@4.6.7)\n+      '@edity/core': 0.1.0(zod@4.6.7)\n       astro: 7.4.2(@types/node@24.19.2)(yaml@2.9.1)\n       zod: 4.6.7\n \n-  '@edity/core@file:vendor/edity-core-0.1.0.tgz(zod@4.6.7)':\n+  '@edity/core@0.1.0(zod@4.6.7)':\n     dependencies:\n       zod: 4.6.7\n "},{"sha":"e627c3bfcb6abfa9f3c663d444cd104cf2b8be58","filename":"pnpm-workspace.yaml","status":"modified","additions":4,"deletions":7,"changes":11,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/4bc931076ac8583bd8905a4c508c987877afc09d/pnpm-workspace.yaml","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/4bc931076ac8583bd8905a4c508c987877afc09d/pnpm-workspace.yaml","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/pnpm-workspace.yaml?ref=4bc931076ac8583bd8905a4c508c987877afc09d","patch":"@@ -5,12 +5,9 @@ allowBuilds:\n   sharp: true\n \n minimumReleaseAge: 4320 # 3 days\n-# minimumReleaseAgeExclude:\n-#   - package-with-critical-hotfix@1.2.3\n+minimumReleaseAgeExclude:\n+  # Edity's own packages, released from RMYPG/edity with provenance: the\n+  # sandbox tries each release as soon as it is out.\n+  - '@edity/*'\n \n trustPolicy: no-downgrade\n-\n-# Until @edity/core 0.1.0 is on npm, @edity/astro's dependency on it also\n-# comes from vendor/ (see vendor/README.md).\n-overrides:\n-  '@edity/core': 'file:vendor/edity-core-0.1.0.tgz'"},{"sha":"fd8938036c031442bd924792a356fdcb80f18f44","filename":"src/content/home.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/4bc931076ac8583bd8905a4c508c987877afc09d/src%2Fcontent%2Fhome.json","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/4bc931076ac8583bd8905a4c508c987877afc09d/src%2Fcontent%2Fhome.json","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/src%2Fcontent%2Fhome.json?ref=4bc931076ac8583bd8905a4c508c987877afc09d","patch":"@@ -5,7 +5,7 @@\n   \"hero\": {\n     \"title\": \"Fisioterapia cerca de ti, sin esperas\",\n     \"lead\": \"Valoramos tu caso en la primera visita y te proponemos un plan claro, con ejercicios que puedes hacer en casa entre sesiones.\",\n-    \"cta\": \"Reserva tu cita\"\n+    \"cta\": \"Pide tu cita\"\n   },\n   \"stats\": {\n     \"patients\": 12500"},{"sha":"2c269bb915df366c63af05936bbcef10c4f13c7b","filename":"vendor/README.md","status":"removed","additions":0,"deletions":15,"changes":15,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/0345f674a02fb499b9e8e1a9cfc4b788db1549e6/vendor%2FREADME.md","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/0345f674a02fb499b9e8e1a9cfc4b788db1549e6/vendor%2FREADME.md","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/vendor%2FREADME.md?ref=0345f674a02fb499b9e8e1a9cfc4b788db1549e6","patch":"@@ -1,15 +0,0 @@\n-# vendor\n-\n-`@edity/core` and `@edity/astro` 0.1.0, packed from [RMYPG/edity](https://github.com/RMYPG/edity) at commit `c69170b` (branch `edity-v1`), until 0.1.0 is published on npm. `package.json` depends on these tarballs, and `pnpm-workspace.yaml` overrides `@edity/astro`'s own dependency on `@edity/core` to the same file.\n-\n-To refresh them from an `edity` checkout:\n-\n-```sh\n-mise run build\n-(cd packages/core && mise exec -- pnpm pack --pack-destination <this folder>)\n-(cd packages/astro && mise exec -- pnpm pack --pack-destination <this folder>)\n-```\n-\n-Then run `mise exec -- pnpm install` here.\n-\n-Once 0.1.0 is on npm, depend on `^0.1.0` instead, remove the override and this folder, and add `@edity/*` to `minimumReleaseAgeExclude` in `pnpm-workspace.yaml` if the release is less than three days old."},{"sha":"f267c0569eed914803e5091206c9308ebfd53039","filename":"vendor/edity-astro-0.1.0.tgz","status":"removed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/0345f674a02fb499b9e8e1a9cfc4b788db1549e6/vendor%2Fedity-astro-0.1.0.tgz","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/0345f674a02fb499b9e8e1a9cfc4b788db1549e6/vendor%2Fedity-astro-0.1.0.tgz","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/vendor%2Fedity-astro-0.1.0.tgz?ref=0345f674a02fb499b9e8e1a9cfc4b788db1549e6"},{"sha":"f52ed1a3b18b51576dfb80728fe5ccbb27aaa2ce","filename":"vendor/edity-core-0.1.0.tgz","status":"removed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/RMYPG/edity-sandbox/blob/0345f674a02fb499b9e8e1a9cfc4b788db1549e6/vendor%2Fedity-core-0.1.0.tgz","raw_url":"https://github.com/RMYPG/edity-sandbox/raw/0345f674a02fb499b9e8e1a9cfc4b788db1549e6/vendor%2Fedity-core-0.1.0.tgz","contents_url":"https://api.github.com/repos/RMYPG/edity-sandbox/contents/vendor%2Fedity-core-0.1.0.tgz?ref=0345f674a02fb499b9e8e1a9cfc4b788db1549e6"}]}
